---
interface Props {
  title: string;
  date: Date;
  slug: string;
  categories?: string[];
  description?: string;
  image?: string;
}

const { title, date, slug, categories = [], description, image } = Astro.props;

const dateFormatted = date.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="bg-white rounded-lg border border-[#E5DFD5] hover:border-brand-steel/50 transition-all flex flex-col overflow-hidden h-full group hover:shadow-xs">
  {image && (
    <div class="h-44 w-full overflow-hidden bg-[#F3EFE9] relative border-b border-[#EBE5DC]">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <!-- Meta: Date + Categories -->
    <div class="flex flex-wrap items-center gap-2 mb-2.5 text-xs text-slate-500">
      <time datetime={date.toISOString()}>{dateFormatted}</time>
      {categories.length > 0 && (
        <>
          <span class="text-slate-300">•</span>
          <span class="text-brand-steel font-medium">{categories.join(', ')}</span>
        </>
      )}
    </div>

    <!-- Title -->
    <h3 class="font-heading font-bold text-base sm:text-lg text-brand-navy leading-snug mb-2.5 group-hover:text-brand-steel transition">
      <a href={`/aktuelles/${slug}`}>
        {title}
      </a>
    </h3>

    <!-- Description -->
    {description && (
      <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4 flex-grow">
        {description}
      </p>
    )}

    <!-- Read More -->
    <div class="pt-3 border-t border-[#EFECE6] mt-auto">
      <a
        href={`/aktuelles/${slug}`}
        class="inline-flex items-center text-xs font-semibold text-brand-navy group-hover:text-brand-steel transition gap-1.5"
      >
        <span>Beitrag lesen</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</article>
