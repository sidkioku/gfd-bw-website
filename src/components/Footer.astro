---
const year = new Date().getFullYear();
---

<footer class="bg-brand-navy text-white mt-auto">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: About -->
      <div class="lg:col-span-1 space-y-4">
        <a href="/" class="inline-block bg-white px-3 py-2 rounded-lg shadow-xs hover:opacity-95 transition" aria-label="Gesellschaft für Dialog Baden-Württemberg e.V. Startseite">
          <img
            src="/images/Logo-GfD-BW--scaled.png"
            alt="Gesellschaft für Dialog Baden-Württemberg e.V."
            class="h-8 sm:h-9 w-auto object-contain"
            width="180"
            height="36"
            loading="lazy"
          />
        </a>
        <p class="text-xs text-slate-300 leading-relaxed">
          „Den Menschen in den Mittelpunkt stellen und Begegnungen schaffen.“ Wir setzen uns seit 2006 für den interkulturellen und interreligiösen Dialog, gesellschaftliche Teilhabe und gegenseitiges Verständnis ein.
        </p>
        <div class="pt-2 flex items-center space-x-3">
          <a href="https://www.facebook.com/DialogBegegnungen/" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-blue flex items-center justify-center transition" aria-label="Facebook">
            <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/gfd_bw" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-blue flex items-center justify-center transition" aria-label="Instagram">
            <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://youtube.com/@gesellschaftfurdialogbaden2564" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-blue flex items-center justify-center transition" aria-label="YouTube">
            <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h3 class="font-heading font-bold text-sm text-brand-light uppercase tracking-wider mb-4">Navigation</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="text-slate-300 hover:text-white transition">Startseite</a></li>
          <li><a href="/veranstaltungen" class="text-slate-300 hover:text-white transition">Termine & Veranstaltungen</a></li>
          <li><a href="/ueber-uns" class="text-slate-300 hover:text-white transition">Über uns & Ziele</a></li>
          <li><a href="/themen" class="text-slate-300 hover:text-white transition">Themen & Schwerpunkte</a></li>
          <li><a href="/projekte" class="text-slate-300 hover:text-white transition">Unsere Projekte</a></li>
          <li><a href="/aktuelles" class="text-slate-300 hover:text-white transition">Aktuelles & Berichte</a></li>
          <li><a href="/mediathek" class="text-slate-300 hover:text-white transition">Mediathek</a></li>
        </ul>
      </div>

      <!-- Col 3: Mitmachen & Mitgliedschaft -->
      <div>
        <h3 class="font-heading font-bold text-sm text-brand-light uppercase tracking-wider mb-4">Mitmachen</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/aktiv-werden" class="text-slate-300 hover:text-white transition">Aktiv werden & Ehrenamt</a></li>
          <li><a href="/mitglied-werden" class="text-slate-300 hover:text-white transition">Mitglied werden</a></li>
          <li><a href="/aktiv-werden#spenden" class="text-slate-300 hover:text-white transition">Spenden & Fördern</a></li>
          <li><a href="/newsletter" class="text-slate-300 hover:text-white transition">Newsletter abonnieren</a></li>
          <li><a href="/ueber-uns/partner" class="text-slate-300 hover:text-white transition">Partnerorganisationen</a></li>
          <li><a href="/ueber-uns/satzung" class="text-slate-300 hover:text-white transition">Vereinssatzung</a></li>
        </ul>
      </div>

      <!-- Col 4: Kontakt & Standorte -->
      <div>
        <h3 class="font-heading font-bold text-sm text-brand-light uppercase tracking-wider mb-4">Kontakt</h3>
        <div class="space-y-3 text-xs text-slate-300">
          <div>
            <strong class="text-white block">Hauptsitz Stuttgart:</strong>
            <p>Oppelner Straße 1<br />70372 Stuttgart</p>
            <p class="mt-1">Tel: <a href="tel:+4971191258075" class="hover:text-white">+49 (0) 711 - 912 580 75</a></p>
          </div>
          <div>
            <strong class="text-white block">Regionalstelle Mannheim:</strong>
            <p>Hans-Thoma-Str. 34<br />68163 Mannheim</p>
            <p class="mt-1"><a href="mailto:mannheim@gfd-bw.org" class="hover:text-white">mannheim@gfd-bw.org</a></p>
          </div>
          <div class="pt-1">
            <a href="mailto:info@gfd-bw.org" class="inline-flex items-center gap-1.5 text-brand-light hover:underline font-semibold">
              info@gfd-bw.org
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Legal -->
  <div class="border-t border-white/10 bg-black/20 text-xs py-4 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-400">
      <p>© {year} Gesellschaft für Dialog Baden-Württemberg e.V. Alle Rechte vorbehalten.</p>
      <div class="flex items-center space-x-6">
        <a href="/impressum" class="hover:text-white transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition">Datenschutzerklärung</a>
        <a href="/kontakt" class="hover:text-white transition">Kontakt</a>
      </div>
    </div>
  </div>
</footer>
