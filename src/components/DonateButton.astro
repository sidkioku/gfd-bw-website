---
interface Props {
  label?: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'outline';
}

const {
  label = 'Jetzt spenden & unterstützen',
  href = '/aktiv-werden#spenden',
  size = 'md',
  variant = 'primary',
} = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
}[size];

const variantClasses = {
  primary: 'bg-brand-blue hover:bg-brand-navy text-white shadow-sm hover:shadow',
  secondary: 'bg-brand-navy hover:bg-brand-blue text-white shadow-sm hover:shadow',
  outline: 'border-2 border-brand-blue text-brand-blue hover:bg-brand-blue hover:text-white',
}[variant];
---

<a
  href={href}
  class={`inline-flex items-center justify-center font-heading font-bold rounded-lg transition-all duration-200 gap-2 ${sizeClasses} ${variantClasses}`}
>
  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
  <span>{label}</span>
</a>
