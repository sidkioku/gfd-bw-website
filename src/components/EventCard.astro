---
interface Props {
  title: string;
  date: Date;
  slug: string;
  location?: string;
  format?: 'praesenz' | 'online' | 'hybrid';
  description?: string;
  categories?: string[];
  past?: boolean;
  image?: string;
}

const {
  title,
  date,
  slug,
  location,
  format = 'praesenz',
  description,
  categories = [],
  past = false,
  image,
} = Astro.props;

const day = date.getDate().toString().padStart(2, '0');
const monthNames = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const month = monthNames[date.getMonth()];
const year = date.getFullYear();
---

<article class="bg-white rounded-lg border border-[#E5DFD5] hover:border-brand-steel/50 transition-all flex flex-col overflow-hidden h-full group hover:shadow-xs">
  {image && (
    <div class="h-44 w-full overflow-hidden bg-[#F3EFE9] relative border-b border-[#EBE5DC]">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <!-- Date Header & Tag -->
    <div class="flex items-start justify-between gap-2 mb-3.5 flex-wrap">
      <div class="flex items-center gap-3">
        <div class="w-12 h-13 bg-[#F5F2EB] text-brand-navy rounded flex flex-col items-center justify-center font-heading border border-[#E2DDD3] flex-shrink-0">
          <span class="text-[10px] tracking-wider uppercase font-semibold text-brand-steel leading-none pt-0.5">{month}</span>
          <span class="text-lg font-bold leading-tight">{day}</span>
        </div>
        <div class="text-xs text-slate-500">
          <span>{year}</span>
          {past && <span class="ml-2 inline-block px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px] font-medium border border-slate-200">Vergangen</span>}
        </div>
      </div>

      <!-- Format & Category Badges -->
      <div class="flex items-center gap-1.5 flex-wrap justify-end">
        {categories.length > 0 && (
          <span class="text-[11px] font-medium text-slate-600 bg-[#F5F2EB] border border-[#E7E2D8] px-2.5 py-0.5 rounded-full truncate max-w-[120px]">
            {categories[0]}
          </span>
        )}
        {format === 'online' ? (
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-sky-800 bg-sky-50 border border-sky-200 px-2 py-0.5 rounded-full">
            <svg class="w-3 h-3 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Online
          </span>
        ) : format === 'hybrid' ? (
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-900 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">
            <svg class="w-3 h-3 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            Hybrid
          </span>
        ) : (
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-700 bg-[#F5F2EB] border border-[#E2DDD3] px-2 py-0.5 rounded-full">
            <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            Vor Ort
          </span>
        )}
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-heading font-bold text-base text-brand-navy leading-snug mb-2 group-hover:text-brand-steel transition">
      <a href={`/veranstaltungen/${slug}`}>
        {title}
      </a>
    </h3>

    <!-- Location / Online Indicator -->
    {format === 'online' ? (
      <p class="text-xs text-slate-500 mb-3 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-sky-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span class="truncate">{location || 'Virtueller Raum (Zoom)'}</span>
      </p>
    ) : location ? (
      <p class="text-xs text-slate-500 mb-3 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-brand-steel flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="truncate">{location}{format === 'hybrid' ? ' · & Online via Zoom' : ''}</span>
      </p>
    ) : null}

    <!-- Description -->
    {description && (
      <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4 flex-grow">
        {description}
      </p>
    )}

    <!-- Action Link -->
    <div class="pt-3 border-t border-[#EFECE6] mt-auto">
      <a
        href={`/veranstaltungen/${slug}`}
        class="inline-flex items-center text-xs font-semibold text-brand-navy group-hover:text-brand-steel transition gap-1.5"
      >
        <span>Details & Information</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</article>
