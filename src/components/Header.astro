---
const currentPath = Astro.url.pathname;

const navItems = [
  {
    name: 'Aktuelles',
    href: '/veranstaltungen',
    children: [
      { name: 'Termine & Veranstaltungen', href: '/veranstaltungen' },
      { name: 'Veranstaltungsarchiv', href: '/veranstaltungen/archiv' },
      { name: 'Aktuelle Beiträge & News', href: '/aktuelles' },
    ],
  },
  {
    name: 'Über uns',
    href: '/ueber-uns',
    children: [
      { name: 'Über die GfD BW', href: '/ueber-uns' },
      { name: 'Unsere Ziele', href: '/ueber-uns/ziele' },
      { name: 'Der Vorstand', href: '/ueber-uns/vorstand' },
      { name: 'Hizmet-Bewegung', href: '/ueber-uns/hizmet-bewegung' },
      { name: 'Satzung', href: '/ueber-uns/satzung' },
      { name: 'Partnerorganisationen', href: '/ueber-uns/partner' },
    ],
  },
  {
    name: 'Themen',
    href: '/themen',
    children: [
      { name: 'Themenübersicht', href: '/themen' },
      { name: 'Interreligiöser & Interkultureller Dialog', href: '/themen/interreligioeser-dialog' },
      { name: 'Gesellschaft & Politik', href: '/themen/gesellschaft-und-politik' },
      { name: 'Gender & Geschlechtergerechtigkeit', href: '/themen/gender-und-geschlechtergerechtigkeit' },
      { name: 'Jugendarbeit', href: '/themen/jugend' },
      { name: 'Kunst & Kultur', href: '/themen/kunst-kultur' },
    ],
  },
  {
    name: 'Projekte',
    href: '/projekte',
    children: [
      { name: 'Aktuelle Projekte', href: '/projekte' },
      { name: 'Abgeschlossene Projekte', href: '/projekte/archiv' },
    ],
  },
  {
    name: 'Kontakt',
    href: '/kontakt',
  },
];
---

<header class="w-full bg-white shadow-sm sticky top-0 z-50">
  <!-- Top Bar -->
  <div class="bg-brand-navy text-white text-xs py-2 px-4 sm:px-8 border-b border-white/10">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center space-x-6">
        <a href="mailto:info@gfd-bw.org" class="hover:text-brand-light transition flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          info@gfd-bw.org
        </a>
        <a href="tel:+4971191258075" class="hover:text-brand-light transition hidden sm:flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          0711 912 580 75
        </a>
      </div>
      <div class="flex items-center space-x-4">
        <span class="text-white/60 hidden md:inline">Folgen Sie uns:</span>
        <a href="https://www.facebook.com/DialogBegegnungen/" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light transition" aria-label="Facebook">
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.instagram.com/gfd_bw" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light transition" aria-label="Instagram">
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://youtube.com/@gesellschaftfurdialogbaden2564" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light transition" aria-label="YouTube">
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group py-1" aria-label="Gesellschaft für Dialog Baden-Württemberg e.V. Startseite">
      <img
        src="/images/Logo-GfD-BW--scaled.png"
        alt="Gesellschaft für Dialog Baden-Württemberg e.V."
        class="h-10 sm:h-12 w-auto object-contain max-w-[220px] sm:max-w-[260px]"
        width="260"
        height="50"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
      {navItems.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class={`px-3 py-2 text-xs xl:text-sm font-semibold tracking-wider transition-colors inline-flex items-center gap-1 rounded-md ${
              currentPath.startsWith(item.href) && item.href !== '/'
                ? 'text-brand-blue bg-brand-light/50 font-bold'
                : 'text-body-text hover:text-brand-blue hover:bg-slate-50'
            }`}
          >
            {item.name}
            {item.children && (
              <svg class="w-3.5 h-3.5" width="14" height="14" text-gray-400 group-hover:text-brand-blue group-hover:rotate-180 transition-transform fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            )}
          </a>

          {item.children && (
            <div class="absolute left-0 top-full hidden group-hover:block pt-1 z-50">
              <div class="w-64 bg-white rounded-lg shadow-xl border border-gray-100 py-2">
                {item.children.map((sub) => (
                  <a
                    href={sub.href}
                    class="block px-4 py-2 text-xs font-medium text-body-text hover:bg-brand-light/60 hover:text-brand-blue transition"
                  >
                    {sub.name}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}

      <!-- CTA Button -->
      <a
        href="/mitglied-werden"
        class="ml-3 bg-brand-navy hover:bg-brand-blue text-white text-xs xl:text-sm font-heading font-semibold px-4 py-2.5 rounded-md shadow-xs hover:shadow transition-all"
      >
        Mitglied werden
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-toggle"
      type="button"
      class="lg:hidden p-2 text-body-text hover:text-brand-blue focus:outline-none"
      aria-label="Menü öffnen"
    >
      <svg class="w-6 h-6" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white px-4 py-6 space-y-3 shadow-lg">
    {navItems.map((item) => (
      <div>
        <a href={item.href} class="block font-heading font-bold text-sm text-brand-navy py-1.5">
          {item.name}
        </a>
        {item.children && (
          <div class="pl-4 space-y-1 mt-1 border-l-2 border-brand-light">
            {item.children.map((sub) => (
              <a href={sub.href} class="block text-xs text-body-text hover:text-brand-blue py-1">
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="pt-4 border-t border-gray-100 flex flex-col gap-2">
      <a
        href="/mitglied-werden"
        class="text-center bg-brand-blue text-white font-heading font-bold text-sm py-2.5 rounded-lg shadow-sm"
      >
        MITGLIED WERDEN
      </a>
      <a
        href="/aktiv-werden"
        class="text-center border border-brand-navy text-brand-navy font-heading font-bold text-sm py-2.5 rounded-lg"
      >
        AKTIV WERDEN & SPENDEN
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden');
    close?.classList.toggle('hidden');
  });
</script>
