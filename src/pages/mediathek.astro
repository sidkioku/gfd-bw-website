---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const galleryPhotos = [
  {
    src: '/images/Fastenbrechen-2024-Hospitalhof-Kopie-scaled.jpg',
    title: 'Fastenbrechen im Hospitalhof Stuttgart',
    category: 'Interreligiöser Dialog',
  },
  {
    src: '/images/025A02521-scaled.jpg',
    title: 'Interreligiöses Gesprächsforum',
    category: 'Begegnungen',
  },
  {
    src: '/images/14490340600_cd3eeb1bbe_o-scaled.jpg',
    title: 'Konzert Symphony of the Earth',
    category: 'Kunst & Kultur',
  },
  {
    src: '/images/Frauenmahl1-scaled.jpg',
    title: 'Interreligiöses Frauenmahl',
    category: 'Gendergerechtigkeit',
  },
  {
    src: '/images/IMG_5995-scaled.jpg',
    title: 'Jugendworkshop & Werte-Botschafter',
    category: 'Jugendarbeit',
  },
  {
    src: '/images/Deutscher_Dialogpreis_2023.jpg',
    title: 'Verleihung Deutscher Dialogpreis',
    category: 'Auszeichnung',
  },
  {
    src: '/images/sebiarus.jpg',
    title: 'Şeb-i Arûs Gedenkabend',
    category: 'Spiritualität & Kultur',
  },
  {
    src: '/images/stuttgartergespraeche.jpg',
    title: 'Stuttgarter Gespräche',
    category: 'Gesellschaft & Politik',
  },
  {
    src: '/images/PHOTO-2026-06-10-11-31-53.jpg',
    title: 'Trialogreise Begegnungen',
    category: 'Studienreisen',
  },
];
---

<BaseLayout title="Mediathek" description="Bilder, Videos und Dokumentationen der Gesellschaft für Dialog Baden-Württemberg e.V.">
  <PageHeader
    title="Mediathek"
    subtitle="Bildergalerien, Videoaufzeichnungen von Podiumsdiskussionen und Mitschnitte unserer Kulturveranstaltungen."
  />

  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-16 space-y-16">
    <!-- Photo Gallery -->
    <section class="space-y-6">
      <div>
        <span class="text-xs font-semibold text-brand-blue uppercase tracking-wider block mb-1">Impressionen</span>
        <h2 class="text-2xl font-heading font-bold text-brand-navy">Bildergalerie vergangener Veranstaltungen</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {galleryPhotos.map((photo) => (
          <div class="bg-white rounded-xl overflow-hidden border border-gray-100 shadow-xs hover:shadow-md transition group">
            <div class="h-48 overflow-hidden bg-slate-100">
              <img
                src={photo.src}
                alt={photo.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <span class="text-[10px] font-semibold text-brand-steel uppercase tracking-wider bg-brand-light/60 px-2 py-0.5 rounded-full inline-block mb-1.5">
                {photo.category}
              </span>
              <h3 class="font-heading font-bold text-sm text-brand-navy">{photo.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- YouTube Video Highlight -->
    <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm space-y-4">
      <h2 class="font-heading font-bold text-xl text-brand-navy">YouTube-Kanal der GfD BW</h2>
      <p class="text-xs sm:text-sm text-body-text leading-relaxed">
        Auf unserem offiziellen YouTube-Kanal finden Sie Aufzeichnungen der Stuttgarter Gesprächsabende, Interviews mit Gastreferenten, musikalische Beiträge von „Symphony of the Earth“ sowie Dokumentationen vergangener Trialogreisen.
      </p>
      <div class="pt-2">
        <a
          href="https://youtube.com/@gesellschaftfurdialogbaden2564"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-heading font-bold text-xs sm:text-sm px-6 py-3 rounded-lg shadow-sm transition"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          GfD BW auf YouTube abonnieren
        </a>
      </div>
    </div>

    <!-- Instagram Feed Teaser -->
    <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm space-y-4">
      <h2 class="font-heading font-bold text-xl text-brand-navy">Aktuelle Eindrücke auf Instagram</h2>
      <p class="text-xs sm:text-sm text-body-text leading-relaxed">
        Folgen Sie unserem Kanal <strong>@gfd_bw</strong> für tagesaktuelle Fotos, Storys von Veranstaltungen und Eindrücke unserer Ehrenamtlichen.
      </p>
      <div class="pt-2">
        <a
          href="https://www.instagram.com/gfd_bw"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 via-pink-600 to-amber-600 text-white font-heading font-bold text-xs sm:text-sm px-6 py-3 rounded-lg shadow-sm transition"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @gfd_bw auf Instagram ansehen
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
