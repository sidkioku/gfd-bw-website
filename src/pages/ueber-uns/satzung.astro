---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="Vereinssatzung" description="Satzung der Gesellschaft für Dialog Baden-Württemberg e.V.">
  <PageHeader
    title="Vereinssatzung"
    subtitle="Rechtliche Grundlage, gemeinnützige Zwecke und organisatorische Verfassung unseres Vereins."
    backLink={{ href: '/ueber-uns', label: 'Zurück zu Über uns' }}
  />

  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-16 space-y-8 text-body-text text-sm sm:text-base leading-relaxed">
    <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-xs space-y-4">
      <h2 class="text-2xl font-bold font-heading text-brand-navy">Gemeinnützigkeit & Vereinszweck</h2>
      <p>
        Die Gesellschaft für Dialog Baden-Württemberg e.V. ist im Vereinsregister des Amtsgerichts Stuttgart unter der Registernummer <strong>VR - 720418</strong> eingetragen und vom zuständigen Finanzamt als gemeinnützig anerkannt.
      </p>
      <p>
        Zweck des Vereins ist die Förderung der Religion, der Kunst und Kultur, der Jugendhilfe, der Erziehung, Volks- und Berufsbildung einschließlich der Studentenhilfe sowie die Förderung internationaler Gesinnung, der Toleranz auf allen Gebieten der Kultur und des Völkerverständigungsgedankens.
      </p>
    </div>

    <div class="bg-slate-50 border border-gray-200 rounded-xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-bold font-heading text-brand-navy mb-1">Offizielle Vereinssatzung herunterladen</h3>
        <p class="text-xs text-body-text">Vollständiger Wortlaut der Satzung in der aktuellen Fassung als PDF.</p>
      </div>
      <a
        href="#"
        class="inline-flex items-center gap-2 bg-brand-blue hover:bg-brand-navy text-white font-heading font-bold text-xs sm:text-sm px-6 py-3 rounded-lg shadow-sm transition flex-shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Satzung (PDF) anfordern
      </a>
    </div>
  </div>
</BaseLayout>
