---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Mitglied werden" description="Werden Sie Mitglied der Gesellschaft für Dialog Baden-Württemberg e.V. – Gemeinsam für Vielfalt und Demokratie.">
  <PageHeader
    title="Mitglied werden"
    subtitle="Gestalten Sie die Zukunft unserer Dialoggesellschaft aktiv mit und stärken Sie unsere Gemeinschaft für Vielfalt und Demokratie."
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-16 space-y-12">
    <div class="bg-white p-8 sm:p-12 rounded-xl border border-gray-100 shadow-sm space-y-6">
      <h2 class="font-heading font-bold text-2xl text-brand-navy">Mitgliedschaftsantrag</h2>
      <p class="text-xs sm:text-sm text-body-text leading-relaxed">
        Als Mitglied der Gesellschaft für Dialog Baden-Württemberg e.V. unterstützen Sie unsere Arbeit ideell und finanziell. Sie werden zu Mitgliederversammlungen eingeladen, können an internen Weiterbildungen teilnehmen und unsere Schwerpunkte aktiv mitbestimmen.
      </p>

      <!-- Netlify Membership Application Form -->
      <form
        name="mitgliedschaft"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-6 pt-4 border-t border-gray-100"
      >
        <input type="hidden" name="form-name" value="mitgliedschaft" />
        <p class="hidden">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="vorname" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Vorname *</label>
            <input type="text" id="vorname" name="vorname" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
          <div>
            <label for="nachname" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Nachname *</label>
            <input type="text" id="nachname" name="nachname" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">E-Mail-Adresse *</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
          <div>
            <label for="telefon" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Telefonnummer</label>
            <input type="tel" id="telefon" name="telefon" class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
        </div>

        <div>
          <label for="adresse" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Straße und Hausnummer *</label>
          <input type="text" id="adresse" name="adresse" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="plz" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">PLZ *</label>
            <input type="text" id="plz" name="plz" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
          <div>
            <label for="ort" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Wohnort *</label>
            <input type="text" id="ort" name="ort" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue" />
          </div>
        </div>

        <div>
          <label for="art" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Art der Mitgliedschaft *</label>
          <select id="art" name="art" required class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue bg-white">
            <option value="Ordentliche Mitgliedschaft">Ordentliches Mitglied (aktive Mitwirkung)</option>
            <option value="Fördermitgliedschaft">Fördermitglied (finanzielle Unterstützung)</option>
            <option value="Schüler / Studierende">Ermäßigte Mitgliedschaft (Schüler, Studierende, Azubis)</option>
          </select>
        </div>

        <div>
          <label for="nachricht" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-2">Bemerkungen / Motivation (optional)</label>
          <textarea id="nachricht" name="nachricht" rows="3" class="w-full px-4 py-3 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue/30 focus:border-brand-blue"></textarea>
        </div>

        <div class="flex items-start gap-2">
          <input type="checkbox" id="satzung-consent" name="satzung-consent" required class="mt-1 text-brand-blue rounded border-gray-300" />
          <label for="satzung-consent" class="text-xs text-body-text">
            Ich erkenne die <a href="/ueber-uns/satzung" class="text-brand-blue underline">Satzung</a> der Gesellschaft für Dialog Baden-Württemberg e.V. an und willige in die Verarbeitung meiner Daten zur Mitgliederverwaltung ein. *
          </label>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto bg-brand-blue hover:bg-brand-navy text-white font-heading font-bold px-8 py-3.5 rounded-lg shadow-sm transition"
        >
          Mitgliedsantrag absenden
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
