---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Aktuelles & Berichte" description="Berichte, Neuigkeiten und Veröffentlichungen der Gesellschaft für Dialog Baden-Württemberg e.V.">
  <PageHeader
    title="Aktuelle Beiträge & Berichte"
    subtitle="Erfahrungsberichte, Pressemitteilungen, Essays und aktuelle Einblicke in unsere landesweite Dialogarbeit."
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          slug={post.slug}
          categories={post.data.categories}
          description={post.data.description}
          image={post.data.image}
        />
      ))}
    </div>
  </div>
</BaseLayout>
